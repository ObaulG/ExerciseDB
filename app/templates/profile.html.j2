<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assistant Maths — Profil</title>
    <link rel="stylesheet" href="/static/css/retro.css">
    <link rel="stylesheet" href="/static/css/auth.css">
    <script defer src="/static/js/auth.js"></script>
</head>
<body>
    <header class="site-banner">
        <h1>Assistant Maths</h1>
        <div class="site-tagline">Évaluateur de réponses &amp; base d'exercices</div>
    </header>

    <div class="layout">
        <aside class="sidebar">
            <div class="sidebar-title">Menu</div>
            <div class="sidebar-auth">
                {% include "_header.html.j2" %}
            </div>
            <nav class="sidebar-nav">
                <a href="/">💬 Chat</a>
                <a href="/exercises">📚 Exercices</a>
                <a href="/training">✏️ Entraînement</a>
                <a href="/settings">⚙️ Paramètres</a>
                <a href="/profile" class="active">👤 Profil</a>
            </nav>
        </aside>

        <main class="content">
            <div class="content-header">
                <h1>👤 Profil</h1>
            </div>

            <div class="content-body">
                <div class="window" id="profile-window">
                    <div class="title-bar">
                        <h2 class="title-bar-text">👤 Profil</h2>
                    </div>
                    <div class="window-body">
                        <p>Bienvenue, <strong id="profile-pseudo">…</strong> !</p>
                        <p>Cette page affichera prochainement votre historique d'évaluations.</p>
                    </div>
                    <div class="status-bar">
                        <span class="status-field">Profil</span>
                        <span class="status-field">v1.0</span>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
