<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assistant Maths — Consulter les exercices</title>
    <link rel="stylesheet" href="/static/css/retro.css">
    <link rel="stylesheet" href="/static/css/exercises.css">
    <link rel="stylesheet" href="/static/css/auth.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>
    <script defer src="/static/js/auth.js"></script>
    <script defer src="/static/js/exercises-shared.js"></script>
    <script defer src="/static/js/browse.js"></script>
</head>
<body>
    <header class="site-banner">
        <h1>Assistant Maths</h1>
        <div class="site-tagline">Évaluateur de réponses &amp; base d'exercices</div>
    </header>

    <div class="layout">
        <aside class="sidebar">
            <div class="sidebar-title">Menu</div>
            <div class="sidebar-auth">
                {% include "_header.html.j2" %}
            </div>
            <nav class="sidebar-nav">
                <a href="/">💬 Chat</a>
                <div class="nav-group">
                    <span class="nav-group-title">📚 Exercices</span>
                    <a href="/exercises">📥 Importer</a>
                    <a href="/browse" class="active">👁️ Consulter</a>
                    <a href="/create">✨ Créer</a>
                </div>
                <a href="/training">✏️ Entraînement</a>
                <a href="/settings">⚙️ Paramètres</a>
                <a href="/profile">👤 Profil</a>
            </nav>
        </aside>

        <main class="content">
            <div class="content-header">
                <h1>👁️ Consulter les exercices</h1>
            </div>

            <div class="content-body">
                <div class="window" id="list-window">
                    <div class="title-bar">
                        <h2 class="title-bar-text">📚 Exercices enregistrés</h2>
                    </div>

                    <div class="window-body">
                        <div id="exercise-list"></div>
                    </div>

                    <div class="status-bar">
                        <span class="status-field">Prêt</span>
                        <span class="status-field" id="exercise-count">0 exercice(s)</span>
                        <span class="status-field">KaTeX + LaTeX</span>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
